# Copier ce fichier en `.env` puis remplir les valeurs.
# Le fichier `.env` ne doit JAMAIS être commité (il est dans .gitignore).

# Django
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données PostGIS
DB_NAME=Ecommune
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# SMTP pour les notifications e-mail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Adresse qui reçoit les alertes
ALERT_RECIPIENT_EMAIL=
